  "activities": [
    {
      "id": "act-div-01",
      "conceptId": "c-div-01",
      "conceptName": "Division Basics & Equal Sharing",
      "subjectCode": "MATH",
      "grade": 4,
      "title": "Equal Sharing & Grouping Fun",
      "titleGujarati": "સરખા ભાગ અને જૂથ બનાવો",
      "activityType": "mcq",
      "difficulty": "Easy",
      "estimatedMinutes": 10,
      "questions": [
        {
          "id": "q-div-1",
          "questionText": "If you have 12 laddus and want to share them equally among 3 friends, how many laddus does each friend get?",
          "questionTextGujarati": "જો તમારી પાસે ૧૨ લાડુ હોય અને ૩ મિત્રો વચ્ચે સરખા ભાગે વહેંચવા હોય, તો દરેકને કેટલા લાડુ મળે?",
          "type": "mcq",
          "options": [
            "3 laddus",
            "4 laddus",
            "5 laddus",
            "6 laddus"
          ],
          "correctAnswer": "4 laddus",
          "explanation": "12 divided by 3 equals 4 (12 ÷ 3 = 4), because 3 × 4 = 12.",
          "hint": "Think: 3 times what number equals 12?"
        },
        {
          "id": "q-div-2",
          "questionText": "Which multiplication fact helps you solve 20 ÷ 5 = ?",
          "questionTextGujarati": "૨૦ ÷ ૫ = ? ઉકેલવા માટે કયો ગુણાકાર મદદ કરે છે?",
          "type": "mcq",
          "options": [
            "5 × 2 = 10",
            "5 × 4 = 20",
            "5 × 5 = 25",
            "4 × 3 = 12"
          ],
          "correctAnswer": "5 × 4 = 20",
          "explanation": "Since 5 × 4 = 20, 20 ÷ 5 = 4. Multiplication and division are inverse operations!"
        },
        {
          "id": "q-div-3",
          "questionText": "True or False: Division is the same as repeated subtraction of the same number.",
          "questionTextGujarati": "સાચું કે ખોટું: ભાગાકાર એ એક જ સંખ્યાની વારંવાર થતી બાદબાકી છે.",
          "type": "true_false",
          "options": [
            "True",
            "False"
          ],
          "correctAnswer": "True",
          "explanation": "Yes! 12 ÷ 4 = 3 means you can subtract 4 from 12 three times until you reach 0."
        },
        {
          "id": "q-div-4",
          "questionText": "A teacher has 15 pencils. She puts 5 pencils in each pencil box. How many pencil boxes are needed?",
          "questionTextGujarati": "શિક્ષક પાસે ૧૫ પેન્સિલ છે. દરેક બોક્સમાં ૫ પેન્સિલ મૂકે છે. તો કેટલા બોક્સ જોઈશે?",
          "type": "mcq",
          "options": [
            "2 boxes",
            "3 boxes",
            "4 boxes",
            "5 boxes"
          ],
          "correctAnswer": "3 boxes",
          "explanation": "15 pencils ÷ 5 pencils per box = 3 boxes. 3 groups of 5 equal 15."
        }
      ],
      "createdAt": "2026-09-01T10:00:00Z"
    },
