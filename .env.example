# ==============================================================================
# ShikshaSetu AI - Environment Variables Configuration
# SFIC Gujarat Hackathon 2026 - Problem Statement PS-60
# Smart Tracking & Remedial Action System for Student Learning Gaps
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Network Configuration
# ------------------------------------------------------------------------------
# Frontend API Base URL:
# - Leave empty or omit when deploying unified on Vercel (defaults to /api/v1)
# - Set to http://localhost:5000/api/v1 when running the standalone Express backend locally
# - Set to https://api.yourdomain.com/api/v1 when hosting the backend on Render/Railway
NEXT_PUBLIC_API_URL=

# Port for standalone Express backend (default: 5000)
PORT=5000

# Node Environment ("development" or "production")
NODE_ENV=development

# Allowed CORS Origin for standalone Express backend
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Supabase, Neon, AWS RDS, Vercel Postgres)
# When omitted, the local in-memory & file-based JSON store (data/shikshasetu_store.json)
# runs transparently for zero-setup evaluation and offline demonstrations.
# DATABASE_URL=postgres://user:password@hostname:5432/shikshasetu_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. Generative AI Model Configuration
# ------------------------------------------------------------------------------
# AI Provider: "gemini" (recommended) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (Get a free key from https://aistudio.google.com)
# When configured, live generative AI powers the AI Tutor, Gap Analyzer,
# Remedial Plan Generator, Worksheet Generator, and Teacher Assistant.
# When omitted, the built-in deterministic pedagogical engine runs transparently.
GEMINI_API_KEY=

# Gemini Model Selection (defaults to gemini-1.5-flash)
# Supported options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
