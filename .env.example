# ==============================================================================
# ShikshaSetu AI - Environment Variables Configuration
# SFIC Gujarat Hackathon 2026 - Problem Statement PS-60
# Smart Tracking & Remedial Action System for Student Learning Gaps
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Network Configuration
# ------------------------------------------------------------------------------
# Frontend API Base URL:
# - Leave empty or omit when deploying unified on Vercel (defaults to /api/v1)
# - Set to http://localhost:5000/api/v1 when running the standalone Express backend locally
# - Set to https://api.yourdomain.com/api/v1 when hosting the backend on Render/Railway
NEXT_PUBLIC_API_URL=

# Port for standalone Express backend (default: 5000)
PORT=5000

# Node Environment ("development" or "production")
NODE_ENV=development

# Allowed CORS Origin for standalone Express backend
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Supabase, Neon, AWS RDS, Vercel Postgres)
# When omitted, the local in-memory & file-based JSON store (data/shikshasetu_store.json)
# runs transparently for zero-setup evaluation and offline demonstrations.
# DATABASE_URL=postgres://user:password@hostname:5432/shikshasetu_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. Generative & Multilingual AI Provider Configuration
# ------------------------------------------------------------------------------
# AI Provider: "gemini" (recommended), "openai", or "offline_fallback"
AI_PROVIDER=gemini

# A. Google Gemini API Key (Get a key from https://aistudio.google.com or https://ai.google.dev/)
# Powers notice simplification, multilingual Gujarati/Hindi comprehension, multimodal audio STT, and Notice Assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# B. OpenAI API Key (Get a key from https://platform.openai.com/)
# Powers GPT-4o-mini message simplification, Whisper-1 speech recognition, and TTS-1 text-to-speech.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# C. Google Cloud Translation API Key (Get a key from https://cloud.google.com/translate)
# Powers high-fidelity translation for English, Gujarati, Hindi, Marathi, and Tamil with entity preservation.
GOOGLE_TRANSLATE_API_KEY=

# D. Anthropic Claude API Key (Get a key from https://console.anthropic.com/)
# Powers Claude 3.5 Sonnet / Haiku for pedagogical chat, nuance simplification, and multilingual reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# E. Bhashini ULCA API Credentials (Government of India - National Language Translation Mission)
# Website: https://bhashini.gov.in/ or https://ulca.bhashini.gov.in/
# Powers sovereign Indian regional language translation (NMT), speech recognition (ASR), and native TTS voices.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_KEY=



# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 & Session Authentication
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origin: https://shikshasetu-ai-iota.vercel.app (or http://localhost:3000)
# Authorized Redirect URI: https://shikshasetu-ai-iota.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cryptographic Session Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=studysaathi_pedagogical_secure_session_secret_gujarat_2026
NEXTAUTH_SECRET=studysaathi_pedagogical_secure_session_secret_gujarat_2026

# Canonical Application Origin
APP_URL=https://shikshasetu-ai-iota.vercel.app

# ------------------------------------------------------------------------------
# 5. Email Verification & OTP Authentication Configuration
# ------------------------------------------------------------------------------
# Provider: "resend" (recommended for Vercel/serverless), "smtp", "sendgrid", or "test"
EMAIL_PROVIDER=resend

# Default Sender Email / Display Name
EMAIL_FROM=StudySaathi AI <onboarding@resend.dev>

# Resend API Key (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP Configuration (Optional alternative for Gmail, AWS SES, or custom school SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SendGrid Configuration (Optional alternative: https://sendgrid.com/)
SENDGRID_API_KEY=
